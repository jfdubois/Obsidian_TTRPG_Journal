        },
        {
          "name": "entityPlane",
          "label": "Plane",
          "description": "",
          "isRequired": false,
          "input": {
            "type": "dataview",
            "query": "dv.pages()\n  .where(p => p.type === \"plane\" && p.world === form.entityWorld)\n  .map(p => p.file.name)"
          }
        },
        {
