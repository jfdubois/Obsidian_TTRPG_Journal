      "name": "newEntity",
      "fields": [
        {
          "name": "entityWorld",
          "label": "entityWorld",
          "description": "",
          "isRequired": false,
          "input": {
            "type": "text",
            "hidden": true
          }
        },
        {
          "name": "entityType",
          "label": "Type",
          "description": "",
          "isRequired": false,
          "input": {
            "type": "select",
            "source": "fixed",
            "options": [
              {
                "value": "character",
                "label": "Character"
              },
              {
                "value": "npc",
                "label": "NPC"
              },
              {
                "value": "place",
                "label": "Place"
              },
              {
                "value": "store",
                "label": "Store"
              },
              {
                "value": "faction",
                "label": "Faction"
              },
              {
                "value": "region",
                "label": "Region"
              },
              {
                "value": "plane",
                "label": "Plane"
              },
              {
                "value": "quest",
                "label": "Quest"
              }
            ]
          }
        },
        {
          "name": "entityName",
          "label": "Name",
          "description": "",
          "isRequired": false,
          "input": {
            "type": "text",
            "hidden": false
          }
        },
        {
          "name": "entityDescription",
          "label": "Short Description",
          "description": "",
          "isRequired": false,
          "input": {
            "type": "text",
            "hidden": false
